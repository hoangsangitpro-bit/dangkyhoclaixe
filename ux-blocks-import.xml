	<item>
		<title>Block 06 - Form Đăng Ký Tư Vấn</title>
		<link>http://localhost/?post_type=blocks&#038;p=2006</link>
		<pubDate>Fri, 06 Nov 2026 01:00:00 +0000</pubDate>
		<dc:creator><![CDATA[admin]]></dc:creator>
		<guid isPermaLink="false">http://localhost/?post_type=blocks&#038;p=2006</guid>
		<description></description>
		<content:encoded><![CDATA[[section bg_color="#ffffff" padding="70px" padding__sm="35px" id="dang-ky-form"]
[row]
[col span="12" span__sm="12"]

[ux_html]
<div class="drive-form-container">
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 36px; align-items: center;">
    
    <div>
      <div class="drive-pill" style="margin-bottom: 12px;">
        <span class="drive-dot-pulse"></span>
        <span>Chỉ còn 4 suất ưu đãi tháng này</span>
      </div>
      
      <h2 style="font-size: 30px; font-weight: 800; color: #0f172a; line-height: 1.25; margin-bottom: 12px;">
        Đăng ký tư vấn & nhận lịch khai giảng mới nhất
      </h2>
      <p style="font-size: 15px; color: #475569; margin-bottom: 20px;">
        Giảm ngay <strong style="color: #1d4ed8;">1.000.000đ</strong> cho 20 học viên đăng ký sớm nhất trong tháng này!
      </p>
      
